        },
        "care_2": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_4.svg",
            "lead": "Add the flower food.",
            "text": "Dissolve the enclosed packet in the water. It feeds and protects your flowers best."
          }
        },
        "care_3": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_6.svg",
            "lead": "Choose the right spot.",
            "text": "Away from direct sunlight, heat, air vents and the fruit bowl."
          }
        },
        "care_4": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_5.svg",
            "lead": "Change the water and refresh.",
            "text": "Every two days. Re-trim stems. Remove wilting petals."
          }
        },
        "care_5": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_7.svg",
            "lead": "Vase not included.",
            "text": "Please have a vase ready before your flowers arrive."
          }
        },
        "care_6": {
          "type": "step",
          "settings": {
            "column": "2",
            "icon": "shopify://shop_images/Artboard_6.svg",
            "lead": "Choose the right spot.",
            "text": "Away from direct sunlight, heat, air vents and the fruit bowl."
          }
        },
        "care_7": {
          "type": "step",
          "settings": {
            "column": "2",
            "icon": "shopify://shop_images/Artboard_5.svg",
            "lead": "Change the water.",
            "text": "Every two days or keep adding water daily."
          }
        },
        "care_8": {
          "type": "step",
          "settings": {
            "column": "2",
            "icon": "shopify://shop_images/Artboard_2.svg",
            "lead": "Remove wilting petals.",
            "text": "Check every few days and remove any petals that are past their best."
          }
        }
