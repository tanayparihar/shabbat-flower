      "type": "flower-care",
      "blocks": {
        "care_1": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_3.svg",
            "lead": "Trim the stems.",
            "text": "Remove rubber bands. Cut at an angle, removing at least 2cm."
