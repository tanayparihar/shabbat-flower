          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_4.svg",
            "lead": "Add the flower food.",
            "text": "Dissolve the enclosed packet in the water. It feeds and protects your flowers best."
          }
        },
        "care_3": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_6.svg",
            "lead": "Choose the right spot.",
            "text": "Away from direct sunlight, heat, air vents and the fruit bowl."
