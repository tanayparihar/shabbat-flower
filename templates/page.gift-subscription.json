        },
        "care_4": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_5.svg",
            "lead": "Change the water and refresh.",
            "text": "Every two days. Re-trim stems. Remove wilting petals."
          }
        },
        "care_5": {
          "type": "step",
          "settings": {
            "column": "1",
            "icon": "shopify://shop_images/Artboard_7.svg",
