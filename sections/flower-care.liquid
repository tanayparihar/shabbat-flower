{% comment %}
  Section contract.
  Shows a heading above two columns of care steps. Each step is a block with an
  icon, a bold opening phrase and an explanation, assigned to either column. The
  columns stack on phones. Reusable on any page.

  @example
  <!-- Add "Flower care" in the theme editor, then add Care step blocks -->
{% endcomment %}

{% liquid
  assign section_settings = section.settings
  assign custom_class = ''
  if section_settings.background_color != blank
    assign custom_class = 'color-custom-' | append: section.id
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
%}

<div class="section-background {{ custom_class }}"></div>
<div
  class="section section--page-width flower-care {{ custom_class }}"
  style="
    --care-padding-start: {{ section_settings.padding_start }}px;
    --care-padding-end: {{ section_settings.padding_end }}px;
  "
>
  <div class="flower-care__content">
    {% if section_settings.heading != blank %}
      <h2 class="flower-care__heading">{{ section_settings.heading | escape }}</h2>
    {% endif %}

    <div class="flower-care__columns">
      {% for column in (1..2) %}
        {% liquid
          assign column_value = column | append: ''
          assign title = section_settings.column_1_title
          if column == 2
            assign title = section_settings.column_2_title
          endif
          assign step_count = 0
          for block in section.blocks
            if block.settings.column == column_value
              assign step_count = step_count | plus: 1
            endif
          endfor
        %}
        {% if title != blank or step_count > 0 %}
          <div class="flower-care__column">
            {% if title != blank %}
              <h3 class="flower-care__title">{{ title | escape }}</h3>
            {% endif %}
            <ul
              class="flower-care__steps list-unstyled"
              role="list"
            >
              {% for block in section.blocks %}
                {% if block.settings.column != column_value %}
                  {% continue %}
                {% endif %}
                <li
                  class="flower-care__step"
                  {{ block.shopify_attributes }}
                >
                  <span class="flower-care__icon">
                    {% if block.settings.icon != blank %}
                      {{
                        block.settings.icon
                        | image_url: width: 210
                        | image_tag: widths: '70, 140, 210', sizes: '70px', loading: 'lazy', alt: ''
                      }}
                    {% endif %}
                  </span>
                  <p class="flower-care__text">
                    {% if block.settings.lead != blank %}
                      <strong>{{ block.settings.lead | escape }}</strong>
                    {% endif %}
                    {{ block.settings.text | escape }}
                  </p>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .flower-care__content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    min-width: 0;
    padding-block: min(var(--care-padding-start), 4rem) min(var(--care-padding-end), 4rem);
  }

  .flower-care__heading,
  .flower-care__title {
    margin: 0;
    text-align: center;
    text-wrap: balance;
  }

  .flower-care__heading {
    color: var(--color-brand-forest);
  }

  .flower-care__columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 2.5rem 3.75rem;
  }

  .flower-care__column,
  .flower-care__steps {
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
  }

  .flower-care__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-brand-raspberry);
  }

  .flower-care__steps {
    margin: 0;
  }

  .flower-care__step {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-block-start: 0.9375rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-brand-forest) 50%, transparent);
  }

  /* A square slot keeps every step's text on the same left edge */
  .flower-care__icon {
    flex: 0 0 3.5rem;
    aspect-ratio: 1;
  }

  .flower-care__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .flower-care__text {
    flex: 1;
    max-width: 30rem;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .flower-care__content {
      padding-block: var(--care-padding-start) var(--care-padding-end);
    }

    .flower-care__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .flower-care__icon {
      flex-basis: 4.375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.flower_care",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "step",
      "name": "t:names.care_step",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "t:settings.column",
          "options": [
            {
              "value": "1",
              "label": "t:options.first_column"
            },
            {
              "value": "2",
              "label": "t:options.second_column"
            }
          ],
          "default": "1"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:settings.icon"
        },
        {
          "type": "text",
          "id": "lead",
          "label": "t:settings.bold_opening"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "column_1_title",
      "label": "t:settings.first_column_title"
    },
    {
      "type": "text",
      "id": "column_2_title",
      "label": "t:settings.second_column_title"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "range",
      "id": "padding_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.flower_care",
      "category": "t:categories.text",
      "blocks": [{ "type": "step" }, { "type": "step", "settings": { "column": "2" } }]
    }
  ]
}
{% endschema %}
