{% comment %}
  Section contract.
  Shows a heading, a rating line and a row of customer quotes entered as blocks.
  A reviews app block can be added alongside, or instead of, the quote blocks.
  Reusable on any page.

  @example
  <!-- Add "Reviews" in the theme editor, then add one Review block per quote -->
{% endcomment %}

{% liquid
  assign section_settings = section.settings
  assign custom_class = ''
  if section_settings.background_color != blank
    assign custom_class = 'color-custom-' | append: section.id
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign app_blocks = section.blocks | where: 'type', '@app'
%}

<div class="section-background {{ custom_class }}"></div>
<div
  class="section section--page-width reviews {{ custom_class }}"
  style="
    --reviews-padding-start: {{ section_settings.padding_start }}px;
    --reviews-padding-end: {{ section_settings.padding_end }}px;
    --reviews-star-color: {{ section_settings.star_color }};
    --reviews-columns: {{ review_blocks.size | at_least: 1 | at_most: 3 }};
  "
>
  <div class="reviews__content">
    {% if section_settings.heading != blank or section_settings.rating_label != blank %}
      <div class="reviews__header">
        {% if section_settings.heading != blank %}
          <h2 class="reviews__heading">{{ section_settings.heading | escape }}</h2>
        {% endif %}
        {% if section_settings.rating_label != blank %}
          <p class="reviews__rating">
            {% if section_settings.rating_link != blank %}
              <a
                href="{{ section_settings.rating_link }}"
                target="_blank"
                rel="noopener"
              >
                {{- section_settings.rating_label | escape -}}
              </a>
            {% else %}
              {{ section_settings.rating_label | escape }}
            {% endif %}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% if review_blocks.size > 0 %}
      <ul
        class="reviews__grid list-unstyled"
        role="list"
      >
        {% for block in review_blocks %}
          <li
            class="reviews__card"
            {{ block.shopify_attributes }}
          >
            <figure class="reviews__figure">
              <div class="reviews__quote-group">
                <p class="reviews__stars">
                  <span aria-hidden="true">
                    {%- for star in (1..block.settings.stars) %}★{% endfor -%}
                  </span>
                  <span class="visually-hidden">
                    {{- 'accessibility.star_rating' | t: rating: block.settings.stars -}}
                  </span>
                </p>
                {% if block.settings.quote != blank %}
                  <blockquote class="reviews__quote">
                    {{- block.settings.quote | escape | newline_to_br -}}
                  </blockquote>
                {% endif %}
              </div>
              {% if block.settings.author != blank %}
                <figcaption class="reviews__author">{{ block.settings.author | escape }}</figcaption>
              {% endif %}
            </figure>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if app_blocks.size > 0 %}
      <div class="reviews__apps">
        {% for block in app_blocks %}
          {% render block %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .reviews__content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    min-width: 0;
    padding-block: min(var(--reviews-padding-start), 4rem) min(var(--reviews-padding-end), 4rem);
    text-align: center;
  }

  .reviews__header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .reviews__header > * {
    margin: 0;
  }

  .reviews__heading {
    color: var(--color-brand-forest);
  }

  .reviews__rating {
    font-family: var(--font-h6--family);
    font-size: var(--font-h6--size);
    font-weight: var(--font-h6--weight);
    line-height: var(--font-h6--line-height);
    letter-spacing: var(--font-h6--letter-spacing);
    text-transform: var(--font-h6--case);
    color: var(--color-brand-berry);
  }

  .reviews__rating a {
    color: inherit;
    text-decoration: none;
  }

  .reviews__rating a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0;
  }

  .reviews__card {
    min-width: 0;
    padding: 2.5rem;
    border: 1px solid var(--color-brand-blush);
    border-radius: var(--brand-radius-lg);
    background-color: var(--color-brand-white);
    box-shadow: 0 0.5rem 2rem rgb(var(--color-brand-warm-dark-rgb) / 0.05);
  }

  .reviews__figure {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    height: 100%;
    margin: 0;
  }

  .reviews__quote-group {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .reviews__stars {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.35;
    letter-spacing: 0.2em;
    color: var(--reviews-star-color);
  }

  .reviews__quote {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-foreground);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .reviews__author {
    font-weight: 600;
    color: var(--color-foreground);
  }

  @media screen and (min-width: 750px) {
    .reviews__content {
      padding-block: var(--reviews-padding-start) var(--reviews-padding-end);
    }
  }

  @media screen and (min-width: 990px) {
    .reviews__grid {
      grid-template-columns: repeat(var(--reviews-columns), minmax(0, 1fr));
      gap: 3.75rem 2.5rem;
      margin-block-start: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.reviews",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "t:names.review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:settings.text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:settings.author"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "t:settings.stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "t:settings.rating_label"
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:settings.star_color",
      "default": "#f4b400"
    },
    {
      "type": "range",
      "id": "padding_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:names.reviews",
      "category": "t:categories.text",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
