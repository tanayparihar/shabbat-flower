

{% if section.settings.marquee %}
  <script
    src="{{ 'marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% elsif section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% capture announcement_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar announcement-bar--align-{{ section.settings.text_alignment }} spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% if section.settings.marquee %}
    <marquee-component
      class="announcement-bar__marquee"
      style="--marquee-direction: normal;"
      data-speed-factor="{{ section.settings.marquee_duration }}"
      data-movement-direction="normal"
    >
      <div
        class="announcement-bar__marquee-wrapper"
        ref="wrapper"
      >
        <div
          class="announcement-bar__marquee-content"
          ref="content"
        >
          <div
            class="announcement-bar__marquee-items"
            ref="marqueeItems[]"
          >
            {{ announcement_blocks }}
          </div>
        </div>
      </div>
    </marquee-component>
  {% else %}
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {{ announcement_blocks }}
    </div>
  </announcement-bar-component>
  {% endif %}
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  /* Prevent text descenders from being clipped by inherited slideshow-styles */
  .announcement-bar__slide {
    place-content: center;
    overflow: visible;
    min-width: 0;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .announcement-bar--align-left .announcement-bar__slides {
    max-width: none;
    margin-inline: 0;
  }

  /* Without arrows the text can use the whole row */
  .announcement-bar--align-left .announcement-bar__slides:only-child {
    width: 100%;
  }

  .announcement-bar--align-left .announcement-bar__text {
    text-align: start;
    line-height: 1.35;
  }

  .announcement-bar--align-left.section--full-width .announcement-bar__slider {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .announcement-bar__marquee {
    --marquee-gap: var(--page-margin);

    display: block;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .announcement-bar__marquee-wrapper {
    display: flex;
    gap: var(--marquee-gap);
    width: max-content;
    white-space: nowrap;
  }

  .announcement-bar__marquee-content,
  .announcement-bar__marquee-items {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    min-width: max-content;
  }

  .announcement-bar__marquee .announcement-bar__slide {
    position: relative;
    max-width: none;
  }

  .announcement-bar__marquee .announcement-bar__text {
    white-space: nowrap;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    .announcement-bar__marquee:not([data-disabled]) .announcement-bar__marquee-wrapper {
      animation: announcement-marquee var(--marquee-speed) linear infinite var(--marquee-direction);
    }

    .announcement-bar__marquee:focus-within .announcement-bar__marquee-wrapper {
      animation-play-state: paused;
    }
  }

  /* Reduced motion: show each message once, wrapped and still */
  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-wrapper,
    .announcement-bar__marquee-content,
    .announcement-bar__marquee-items {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      min-width: 0;
      white-space: normal;
    }

    .announcement-bar__marquee-content[aria-hidden='true'],
    .announcement-bar__marquee-items[aria-hidden='true'] {
      display: none;
    }

    .announcement-bar__marquee .announcement-bar__text {
      white-space: normal;
      text-align: center;
    }
  }

  @keyframes announcement-marquee {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "t:settings.marquee",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_duration",
      "label": "t:settings.marquee_duration",
      "info": "t:info.marquee_duration",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "sec",
      "default": 20,
      "visible_if": "{{ section.settings.marquee }}"
    },
    {
      "type": "range",
      "visible_if": "{{ section.settings.marquee == false }}",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:settings.alignment",
      "visible_if": "{{ section.settings.marquee == false }}",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
