{% comment %}
  Section contract.
  Shows a photo beside a heading and a list of benefits separated by divider
  lines. Each benefit is a block with an icon, title, text and note. On screens
  narrower than 1200px the photo sits above the text. The photo keeps its own
  shape and is never cropped. Reusable on any page.

  @example
  <!-- Add "Benefit list" in the theme editor, then add one Benefit block per row -->
{% endcomment %}

{% liquid
  assign section_settings = section.settings
  assign custom_class = ''
  if section_settings.background_color != blank
    assign custom_class = 'color-custom-' | append: section.id
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
%}

<div class="section-background {{ custom_class }}"></div>
<div
  class="section section--page-width benefit-list {{ custom_class }}"
  style="
    --benefit-padding-start: {{ section_settings.padding_start }}px;
    --benefit-padding-end: {{ section_settings.padding_end }}px;
  "
>
  <div class="benefit-list__layout{% if section_settings.image == blank %} benefit-list__layout--no-image{% endif %}">
    {% if section_settings.image != blank %}
      <div class="benefit-list__media">
        {{
          section_settings.image
          | image_url: width: 1600
          | image_tag: widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 1200px) 50vw, 100vw', loading: 'lazy'
        }}
      </div>
    {% endif %}

    <div class="benefit-list__content">
      {% if section_settings.heading != blank %}
        <h2 class="benefit-list__heading">{{ section_settings.heading | escape }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <ul
          class="benefit-list__items list-unstyled"
          role="list"
        >
          {% for block in section.blocks %}
            <li
              class="benefit-list__item"
              {{ block.shopify_attributes }}
            >
              <span class="benefit-list__icon">
                {% if block.settings.icon != blank %}
                  {{
                    block.settings.icon
                    | image_url: width: 240
                    | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', alt: ''
                  }}
                {% endif %}
              </span>
              <div class="benefit-list__body">
                {% if block.settings.title != blank %}
                  <h3 class="benefit-list__title">{{ block.settings.title | escape }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="benefit-list__text">{{ block.settings.text | escape | newline_to_br }}</p>
                {% endif %}
                {% if block.settings.note != blank %}
                  <p class="benefit-list__note">{{ block.settings.note | escape }}</p>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .benefit-list__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
    min-width: 0;
    padding-block: min(var(--benefit-padding-start), 4rem) min(var(--benefit-padding-end), 4rem);
  }

  .benefit-list__media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .benefit-list__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .benefit-list__heading {
    margin: 0;
    color: var(--color-brand-forest);
    text-wrap: balance;
  }

  .benefit-list__items {
    margin: 0;
  }

  .benefit-list__item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-brand-forest) 50%, transparent);
  }

  .benefit-list__item:last-child {
    padding-block-end: 0;
  }

  /* A fixed slot keeps every benefit's text on the same left edge */
  .benefit-list__icon {
    flex: 0 0 3.5rem;
    aspect-ratio: 1;
  }

  .benefit-list__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .benefit-list__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
  }

  .benefit-list__body > * {
    max-width: 30rem;
    margin: 0;
  }

  .benefit-list__title {
    font-family: var(--font-heading--family);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-brand-forest);
  }

  .benefit-list__text,
  .benefit-list__note {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .benefit-list__note {
    font-style: italic;
  }

  @media screen and (min-width: 750px) {
    .benefit-list__layout {
      padding-block: var(--benefit-padding-start) var(--benefit-padding-end);
    }

    .benefit-list__item {
      gap: 2.5rem;
    }

    .benefit-list__icon {
      flex-basis: 4.375rem;
    }
  }

  @media screen and (min-width: 1200px) {
    .benefit-list__layout:not(.benefit-list__layout--no-image) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.benefit_list",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "benefit",
      "name": "t:names.benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:settings.icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "text",
          "id": "note",
          "label": "t:settings.note"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.color4 }}"
    },
    {
      "type": "range",
      "id": "padding_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:names.benefit_list",
      "category": "t:categories.text",
      "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }]
    }
  ]
}
{% endschema %}
