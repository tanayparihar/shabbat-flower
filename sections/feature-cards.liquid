{% comment %}
  Section contract.
  Shows a heading above up to three cards. On desktop the first card is large and
  the others stack beside it. A card with an image places its text over the image;
  a card without one is a solid color panel. Reusable on any page.

  @example
  <!-- Add "Feature cards" in the theme editor, then add up to three Card blocks -->
{% endcomment %}

{% liquid
  assign section_settings = section.settings
  assign custom_class = ''
  if section_settings.background_color != blank
    assign custom_class = 'color-custom-' | append: section.id
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
%}

<div class="section-background {{ custom_class }}"></div>
<div
  class="section section--page-width feature-cards {{ custom_class }}"
  style="
    --feature-padding-start: {{ section_settings.padding_start }}px;
    --feature-padding-end: {{ section_settings.padding_end }}px;
    --feature-height: {{ section_settings.card_height }}px;
  "
>
  <div class="feature-cards__content">
    {% if section_settings.heading != blank %}
      <h2 class="feature-cards__heading">{{ section_settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul
        class="feature-cards__grid list-unstyled"
        role="list"
      >
        {% for block in section.blocks %}
          {% liquid
            assign card = block.settings
            assign image_position = 'object-position: ' | append: card.image.presentation.focal_point
            assign sizes = '(min-width: 990px) 33vw, 100vw'
            if forloop.first
              assign sizes = '(min-width: 990px) 62vw, 100vw'
            endif
          %}
          <li
            class="feature-cards__card{% if card.image != blank %} feature-cards__card--media{% endif %}"
            {{ block.shopify_attributes }}
          >
            {% if card.image != blank %}
              {{
                card.image
                | image_url: width: 2000
                | image_tag:
                  class: 'feature-cards__image',
                  widths: '400, 600, 800, 1200, 1600, 2000',
                  sizes: sizes,
                  loading: 'lazy',
                  style: image_position
              }}
            {% endif %}
            <div class="feature-cards__body">
              {% if card.label != blank %}
                <p class="feature-cards__label">{{ card.label | escape }}</p>
              {% endif %}
              {% if card.title != blank %}
                <h3 class="feature-cards__title">{{ card.title | escape }}</h3>
              {% endif %}
              {% if card.text != blank %}
                <p class="feature-cards__text">{{ card.text | escape | newline_to_br }}</p>
              {% endif %}
              {% if card.link_label != blank and card.link != blank %}
                <a
                  class="feature-cards__link"
                  href="{{ card.link }}"
                >
                  {{- card.link_label | escape }} <span aria-hidden="true">→</span></a
                >
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .feature-cards__content {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    min-width: 0;
    padding-block: min(var(--feature-padding-start), 4rem) min(var(--feature-padding-end), 4rem);
  }

  .feature-cards__heading {
    margin: 0;
    color: var(--color-brand-forest);
    text-align: center;
    text-wrap: balance;
  }

  .feature-cards__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
  }

  .feature-cards__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--brand-radius-md);
    background-color: var(--color-brand-forest);
  }

  .feature-cards__card--media {
    min-height: 34rem;
  }

  .feature-cards__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-cards__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.75rem;
    color: var(--color-brand-white);
  }

  /* Shades the lower part of a photo so the text stays readable */
  .feature-cards__card--media .feature-cards__body {
    --feature-shade: color-mix(in srgb, var(--color-brand-forest) 30%, black);

    padding-block-start: 6.25rem;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--feature-shade) 75%, transparent) 75%
    );
  }

  .feature-cards__body > * {
    margin: 0;
  }

  .feature-cards__label {
    padding: 0.5rem 1rem;
    border-radius: var(--brand-radius-pill);
    background-color: var(--color-brand-paper);
    color: var(--color-brand-berry);
  }

  .feature-cards__label,
  .feature-cards__link {
    font-family: var(--font-h6--family);
    font-size: var(--font-h6--size);
    font-weight: var(--font-h6--weight);
    line-height: var(--font-h6--line-height);
    letter-spacing: var(--font-h6--letter-spacing);
    text-transform: var(--font-h6--case);
  }

  .feature-cards__label + * {
    margin-block-start: 1.25rem;
  }

  .feature-cards__title {
    font-family: var(--font-heading--family);
    font-size: 1.6875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .feature-cards__text {
    color: inherit;
  }

  .feature-cards__link {
    margin-block-start: 1.25rem;
    padding-block: 0.625rem;
    color: var(--color-brand-white);
    text-decoration: none;
  }

  .feature-cards__card:not(.feature-cards__card--media) .feature-cards__link {
    margin-block-start: 0.75rem;
  }

  .feature-cards__link:hover {
    color: var(--color-brand-white);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .feature-cards__link:focus-visible {
    outline: 2px solid var(--color-brand-white);
    outline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    .feature-cards__content {
      padding-block: var(--feature-padding-start) var(--feature-padding-end);
    }

  }

  @media screen and (min-width: 990px) {
    .feature-cards__grid {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      min-height: var(--feature-height);
    }

    .feature-cards__card--media {
      min-height: 20rem;
    }

    .feature-cards__card:first-child,
    .feature-cards__card:nth-child(2):last-child {
      grid-row: 1 / -1;
    }

    .feature-cards__card:first-child:last-child {
      grid-column: 1 / -1;
    }

    .feature-cards__card--media:first-child .feature-cards__body {
      padding: 7.5rem 2.25rem 2.25rem;
    }

    .feature-cards__card--media:not(:first-child) .feature-cards__body {
      padding-inline: 2rem;
      padding-block-end: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.feature_cards",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "card",
      "name": "t:names.card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:settings.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "t:settings.height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "range",
      "id": "padding_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:names.feature_cards",
      "category": "t:categories.text",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
